# Maintainer: QPRS-6 <qprsyyds@gmail.com>
pkgname=freepiano-linux
pkgver=1.0.12
pkgrel=1
pkgdesc="Native Linux port of FreePiano 1.8 with the built-in mdaPiano instrument"
arch=('x86_64')
url="https://github.com/QPRS-6/freepiano-linux"
license=('BSD-3-Clause' 'MIT')
depends=('qt6-base' 'qt6-wayland' 'portaudio' 'alsa-lib' 'zlib' 'fluidsynth' 'libpulse' 'hicolor-icon-theme')
makedepends=('cmake' 'ninja' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('71eb0a1524d8366e0c2a02c709584dc16c179fa61b6e8f34caa3b05fbc0c9fb5')

build() {
  cmake -S "$pkgname-$pkgver" -B build \
    -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DFP_WITH_FLUIDSYNTH=ON \
    -DFP_WITH_PULSE=ON \
    -DFP_WITH_MIDI=ON \
    -DFP_EMBED_SOURCE_DATA_DIR=OFF \
    -Wno-dev
  cmake --build build --parallel
}

package() {
  DESTDIR="$pkgdir" cmake --install build

  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/$pkgname-$pkgver/LICENSES/mdaPiano-MIT.txt" \
    "$pkgdir/usr/share/licenses/$pkgname/mdaPiano-MIT.txt"
}
